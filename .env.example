# =============================================================================
# Copy to .env and fill in. Never commit .env.
# Every variable here is validated by the Zod schema in packages/config at boot;
# a missing required value fails the process with a readable message rather than
# surfacing as undefined behaviour halfway through a request.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug                          # trace | debug | info | warn | error

API_PORT=3001
API_HOST=0.0.0.0

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# -----------------------------------------------------------------------------
# LLM gateway (OpenAI-compatible)
#
# The gateway speaks the OpenAI wire format, so one adapter serves any provider.
# To switch providers, change the base URL and key — not the code.
# -----------------------------------------------------------------------------
LLM_PRIMARY_PROVIDER=ramclouds

RAMCLOUDS_API_KEY=
RAMCLOUDS_BASE_URL=https://ramclouds.me/v1

# Optional failover. Leave LLM_FALLBACK_PROVIDER empty to disable.
# Any OpenAI-compatible endpoint works here (OpenRouter, OpenAI, local vLLM).
LLM_FALLBACK_PROVIDER=
FALLBACK_API_KEY=
FALLBACK_BASE_URL=

# Model IDs are gateway-specific opaque strings. Only set LLM_MODEL_REASONING to a
# model that has passed the tool-calling smoke test (the spec §4.5).
LLM_MODEL_REASONING=gpt-5               # agent tool-selection loop — needs tool calling
LLM_MODEL_REWRITE=gpt-5-mini            # query rewriting / translation — small and fast
LLM_MODEL_ANSWER=gpt-5                  # final answer generation
LLM_MODEL_VERIFY=gpt-5-mini             # LLM verification

LLM_TIMEOUT_MS=30000
# SDK-level retries stay at 0 — Temporal owns the retry policy. Do not raise this.
LLM_MAX_RETRIES=0

# -----------------------------------------------------------------------------
# PostgreSQL — needs the pg_bigm extension for the character n-gram index
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poetry_search
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Qdrant
#
# The collection is versioned and accessed through an alias; the ingest pipeline
# builds poetry_vN+1 and flips the alias rather than mutating a live collection.
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_ALIAS=poetry

# -----------------------------------------------------------------------------
# Model sidecar (embeddings + reranker)
#
# The API asserts at boot that the sidecar's reported model ID matches the one
# recorded in the Qdrant collection metadata, and refuses to start on mismatch.
# Do not disable that check — a silent index/query model mismatch degrades
# retrieval quality without any visible error.
# -----------------------------------------------------------------------------
MODEL_SERVICE_URL=http://localhost:8000
MODEL_SERVICE_TIMEOUT_MS=15000
EMBEDDING_MODEL_ID=BAAI/bge-m3
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3

# -----------------------------------------------------------------------------
# Corpus — chinese-poetry (MIT)
#
# Pin the commit. Provenance on every local result references this SHA, and an
# unpinned corpus makes retrieval regressions impossible to attribute.
# -----------------------------------------------------------------------------
CORPUS_REPO_URL=https://github.com/chinese-poetry/chinese-poetry
CORPUS_COMMIT_SHA=
CORPUS_DATA_DIR=./data/chinese-poetry
CORPUS_COLLECTIONS=全唐詩,宋詞          # comma-separated; start small

# -----------------------------------------------------------------------------
# Temporal (Phase 4)
# -----------------------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=search

# -----------------------------------------------------------------------------
# Redis — WebSocket fan-out across API instances (Phase 4)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Agent budgets
#
# On exhaustion the run emits agent_budget_exhausted and answers from whatever
# evidence it has, marked partial. It does not fail silently.
# -----------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_WALL_CLOCK_MS=60000
AGENT_MAX_COST_USD=0.50
TOOL_DEFAULT_TIMEOUT_MS=8000

# -----------------------------------------------------------------------------
# External search tools
#
# thivien / ctext / souyun are scraped rather than API-based. Check each site's
# terms and rate limits before enabling, keep the delay conservative, and set a
# user agent that identifies the project and gives a contact address.
# -----------------------------------------------------------------------------
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

TOOL_THIVIEN_ENABLED=false              # Vietnamese Hán-Nôm — not in the local corpus
TOOL_CTEXT_ENABLED=false
TOOL_SOUYUN_ENABLED=false

TOOL_HTTP_USER_AGENT=poetry-search/0.1 (contact: you@example.com)
TOOL_SCRAPE_DELAY_MS=1000
TOOL_CACHE_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=poetry-search
DEBUG_MODE_ENABLED=true                 # exposes ToolResult.raw — keep false in production
