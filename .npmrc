engine-strict=false
auto-install-peers=true
strict-peer-dependencies=false

# The stack is locked to Node 22 LTS. pnpm downloads and uses this
# version for every script and `pnpm exec`, so the project does not depend on which Node
# happens to be active on the machine. Machine-wide switching (`nvm use 22`) needs admin
# on Windows; this does not.
use-node-version=22.23.2
